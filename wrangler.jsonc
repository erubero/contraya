{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warraya",
  "compatibility_date": "2026-07-09",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
