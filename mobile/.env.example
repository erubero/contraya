# Copy to .env and fill from your Supabase project (Settings, API).
# Leave blank to run the app in demo mode with seeded data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (safe to embed). Use the appl_/goog_ keys from the
# RevenueCat dashboard once the store apps are linked. Blank = no paywall.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
